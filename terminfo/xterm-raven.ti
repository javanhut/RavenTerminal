# Raven Terminal terminfo entry. Compile with: tic -x -o ~/.terminfo terminfo/xterm-raven.ti
# (imlazy terminfo, or scripts/install.sh, which installs it system-wide).
xterm-raven|Raven Terminal,
	Tc, RGB, Su, fullkbd, XT, hs,
	Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
	Ms=\E]52;%p1%s;%p2%s\007,
	Ss=\E[%p1%d q, Se=\E[2 q,
	tsl=\E]2;, fsl=^G, dsl=\E]2;\E\\,
	kxIN=\E[I, kxOUT=\E[O,
	use=xterm-256color,
